{
  "name": "mdx-butler",
  "version": "0.6.0",
  "description": "",
  "private": false,
  "repository": "https://github.com/NicoZweifel/mdx-butler",
  "type": "module",
  "license": "MIT",
  "author": "Nico Zweifel",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "types": "./build/index.d.ts"
    },
    "./client": {
      "import": "./build/client.js",
      "types": "./build/client.d.ts"
    }
  },
  "scripts": {
    "publish": "pnpm publish -r",
    "version": "pnpm version -r",
    "prepublish": "npm-run-all build:clean build",
    "compile": "tsc",
    "compile:watch": "tsc",
    "watch": "npm-run-all compile:watch",
    "build:clean": "rimraf ./build",
    "build": "npm-run-all compile",
    "format": "prettier **/*.{cjs,js,ts,tsx,css,json,md,mdx} --write",
    "lint": "eslint **/*.{ts,tsx,mdx} --fix",
    "test": "vitest"
  },
  "keywords": [],
  "peerDependencies": {
    "mdx-bundler": ">= 10.0.0"
  },
  "dependencies": {
    "estree-util-build-jsx": "3.0.1",
    "glob": "^13.0.6",
    "mdast-util-mdx": "^3.0.0",
    "mdast-util-mdx-expression": "^2.0.1",
    "mdast-util-to-markdown": "^2.1.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/unist": "^3.0.3",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "esbuild": "^0.27.4",
    "eslint": "^10.1.0",
    "eslint-plugin-mdx": "^3.7.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-vitest": "^0.5.4",
    "mdx-bundler": "^10.1.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.2",
    "vitest": "^4.1.1"
  }
}
